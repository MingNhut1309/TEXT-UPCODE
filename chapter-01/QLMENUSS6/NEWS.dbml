<?xml version="1.0" encoding="utf-8"?><Database Name="NEWS5" Class="NEWSDataContext" xmlns="http://schemas.microsoft.com/linqtosql/dbml/2007">
  <Table Name="dbo.Acounts" Member="Acounts">
    <Type Name="Acount">
      <Column Name="Username" Type="System.String" DbType="VarChar(50) NOT NULL" IsPrimaryKey="true" CanBeNull="false" />
      <Column Name="Password" Type="System.String" DbType="VarChar(50) NOT NULL" CanBeNull="false" />
      <Column Name="Fullname" Type="System.String" DbType="NVarChar(100) NOT NULL" CanBeNull="false" />
      <Column Name="Permission" Type="System.Int32" DbType="Int" CanBeNull="true" />
      <Column Name="Email" Type="System.String" DbType="VarChar(100)" CanBeNull="true" />
      <Column Name="Lock" Type="System.Int32" DbType="Int" CanBeNull="true" />
      <Column Name="Active" Type="System.Int32" DbType="Int" CanBeNull="true" />
      <Association Name="Acount_Menus" Member="Menus" ThisKey="Username" OtherKey="UserAdd" Type="Menus" />
      <Association Name="Acount_PageItem" Member="PageItems" ThisKey="Username" OtherKey="UserAdd" Type="PageItem" />
    </Type>
  </Table>
  <Table Name="dbo.Menus" Member="Menus">
    <Type Name="Menus">
      <Column Name="ID_MN" Type="System.Int32" DbType="Int NOT NULL" IsPrimaryKey="true" CanBeNull="false" />
      <Column Name="Parent" Type="System.Int32" DbType="Int" CanBeNull="true" />
      <Column Name="Pos" Type="System.Int32" DbType="Int" CanBeNull="true" />
      <Column Name="Lable" Type="System.String" DbType="NVarChar(150) NOT NULL" CanBeNull="false" />
      <Column Name="UrlLink" Type="System.String" DbType="VarChar(255)" CanBeNull="true" />
      <Column Name="OrderKey" Type="System.Int32" DbType="Int" CanBeNull="true" />
      <Column Name="UserAdd" Type="System.String" DbType="VarChar(50)" CanBeNull="true" />
      <Column Name="Hide" Type="System.Int32" DbType="Int" CanBeNull="true" />
      <Association Name="Menus_PageItem" Member="PageItems" ThisKey="ID_MN" OtherKey="ID_MN" Type="PageItem" />
      <Association Name="Acount_Menus" Member="Acount" ThisKey="UserAdd" OtherKey="Username" Type="Acount" IsForeignKey="true" />
    </Type>
  </Table>
  <Table Name="dbo.PageItems" Member="PageItems">
    <Type Name="PageItem">
      <Column Name="ID_P" Type="System.Int32" DbType="Int NOT NULL" IsPrimaryKey="true" CanBeNull="false" />
      <Column Name="ID_MN" Type="System.Int32" DbType="Int" CanBeNull="true" />
      <Column Name="Title" Type="System.String" DbType="NVarChar(255) NOT NULL" CanBeNull="false" />
      <Column Name="Sumary" Type="System.String" DbType="NVarChar(MAX)" CanBeNull="true" />
      <Column Name="Contents" Type="System.String" DbType="NVarChar(MAX)" CanBeNull="true" />
      <Column Name="CreaDate" Type="System.DateTime" DbType="DateTime" CanBeNull="true" />
      <Column Name="ModiDate" Type="System.DateTime" DbType="DateTime" CanBeNull="true" />
      <Column Name="OrderKey" Type="System.Int32" DbType="Int" CanBeNull="true" />
      <Column Name="UserAdd" Type="System.String" DbType="VarChar(50)" CanBeNull="true" />
      <Column Name="UserTest" Type="System.String" DbType="VarChar(50)" CanBeNull="true" />
      <Column Name="Hide" Type="System.Int32" DbType="Int" CanBeNull="true" />
      <Association Name="Menus_PageItem" Member="Menus" ThisKey="ID_MN" OtherKey="ID_MN" Type="Menus" IsForeignKey="true" />
      <Association Name="Acount_PageItem" Member="Acount" ThisKey="UserAdd" OtherKey="Username" Type="Acount" IsForeignKey="true" />
    </Type>
  </Table>
</Database>