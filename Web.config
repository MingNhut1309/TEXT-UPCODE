<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Dùng SQL Server Express thì đổi Data Source thành .\SQLEXPRESS -->
    <add name="CINEMA"
         connectionString="Data Source=DESKTOP-SL2HK6I;Initial Catalog=CINEMA;Integrated Security=True;TrustServerCertificate=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <globalization culture="vi-VN" uiCulture="vi-VN" fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
    <sessionState timeout="30" />
    <pages controlRenderingCompatibilityVersion="4.0" />
  </system.web>
</configuration>
